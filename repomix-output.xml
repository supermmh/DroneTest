void MMC5983::init_regs()
{
    write_reg_blocking(MMC5983_REG_CTRL1, 0x80);
    delay_us(15000);
    write_reg_blocking(MMC5983_REG_CTRL3, 0x00);
    delay_us(5000);
    write_reg_blocking(MMC5983_REG_CTRL0, 0x08);
    delay_us(10000);
